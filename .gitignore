# 本地配置含 AppSecret，永不入库
/config/config.local.toml
/config/env

# 运行期数据
/.temp/
/media/
/bin/
qqbot
qqbot.exe

# SQLite
*.db
*.db-wal
*.db-shm
# 单实例锁文件（<store.path>.lock），随进程存活，不删不入库
*.db.lock

# 私有插件工作区：plugins/<repo>/ 是独立仓的嵌套克隆，只见于各自的工作区。
# 白名单只留示例插件——新增示例插件必须在这里补一行，否则会被静默忽略。
/plugins/*
!/plugins/echo
!/plugins/adminping
!/plugins/bootnotice
!/plugins/md

# 由 tools/genplugins 生成：把 plugins/ 下的插件编进二进制的唯一开关。
# 不入库——核心仓克隆下来只带 main.go 里的示例插件，插件工作区跑一次
# `go generate ./cmd/bot` 即可把新插件纳入构建。
/cmd/bot/plugins_gen.go

# 编辑器 / 本地工具状态
.idea/
.vscode/
.workbuddy/
*.swp

# Python 工具的字节码缓存（tools/ 下只有生成期脚本）
__pycache__/
*.pyc
