# 本地配置含 AppSecret，永不入库
/config/config.local.toml
/config/env

# 运行期数据
/.temp/
/media/
/bin/
# GoReleaser 的中间产物与发布资产（含 tools/index 整理出的 dist/plugins/），
# 都在本地生成，不入库。
/dist/
qqbot
qqbot.exe
# `go build ./cmd/bot` 的默认产物名
/bot
/bot.exe
# 测试夹具同理（pkg/rpcsdk 的端到端用例把产物放进 .temp/，但手跑会落到仓库根）
/testplugin
/testplugin.exe
# devrun 的中间产物与 Windows 上被改名腾位的旧二进制
/bot.new
/bot.new.exe
/bot.old
/bot.old.exe

# SQLite
*.db
*.db-wal
*.db-shm
# 单实例锁文件（<store.path>.lock），随进程存活，不删不入库
*.db.lock

# 私有插件工作区：plugins/<repo>/ 是独立仓的嵌套克隆，只见于各自的工作区。
# 白名单只留示例插件——新增示例插件必须在这里补一行，否则会被静默忽略。
/plugins/*
!/plugins/echo
!/plugins/adminping
!/plugins/bootnotice
!/plugins/md

# 出厂插件产物：`go run ./tools/build plugins` 按平台写进各目录，再由核心
# go:embed 内嵌（ADR-0005 决策 11）。产物不入库，只保留 .gitkeep 占位——
# 目录里没有匹配文件时 //go:embed 直接编译失败。
/internal/pluginbundle/dist/*/*
!/internal/pluginbundle/dist/*/.gitkeep

# 架构设计与 ADR 只在本地维护，不入库（2026-10-24 起连同历史一并剔除）。
# 代码注释里的 `docs/xxx.md §x.y` 指的是这份本地文档，干净克隆里不存在。
/docs/

# 编辑器 / 本地工具状态
.idea/
.vscode/
.workbuddy/
# WorkBuddy 的工作区数据（本地记忆与日志），与 .workbuddy/ 同理不入库
.workbuddy-ai/
*.swp

# Python 工具的字节码缓存（tools/ 下只有生成期脚本）
__pycache__/
*.pyc
