[Unit]
Description=QQ Bot
After=network-online.target
Wants=network-online.target
# 防止 session 配额（1000 天）被重启循环吃掉：配置错就停在 failed 等人看。
# 这两个键自 v229 起归 [Unit]（[Service] 里只剩废弃别名）。写在 [Service] 时
# StartLimitIntervalSec 会被忽略并告警，退回默认 10s——配合 RestartSec=10
# 等于永不触发，防重启循环的闸门形同不存在。
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=qqbot
# 二进制装在 /var/lib/qqbot/bin 而不是 /opt/qqbot/bin：/upgrade apply 的落位
# 是「同卷临时文件 + rename」（ADR-0006 决策 5），要求目标目录对服务账号可写，
# 而 ProtectSystem=strict 把 /opt 与 /usr 一起钉成只读。
#
# 另一条路是给 /opt/qqbot/bin 加一条 ReadWritePaths——它能跑，但代价是把
# 「程序目录只读」这一条加固面永久放开：升级通道本身就是远程代码执行通道
# （ADR-0006「代价」第一条），再给它一块系统级的可写程序目录只是扩大了
# 攻击面，换来的仅仅是一个路径写法。/var/lib/qqbot 本来就要写（库、插件、
# 快照），把 bin 放进去不需要新增任何一条 ReadWritePaths。
#
# WorkingDirectory 与数据目录重合：插件子进程不设 cmd.Dir/cmd.Env
# （internal/pluginproc/spawn.go），cwd 直接继承核心；而 [store].path 若写
# 相对路径（示例的 ./data/qqbot.db）就是相对它解析的。核心与插件必须
# 看到同一个 cwd，否则 ImageSourceFile 的相对路径会两边各读一处（§3.9 的
# 已知取舍）。
WorkingDirectory=/var/lib/qqbot
ExecStart=/var/lib/qqbot/bin/qqbot -c /etc/qqbot/config.toml
# 双保险：cron 与主动消息日预算都由程序内的 Asia/Shanghai 决定（不读 TZ），
# 但 Debian 12 默认 UTC，日志时间戳与任何依赖本地时区的库都会偏 8 小时。
Environment=TZ=Asia/Shanghai
# 单实例锁的 appID 维度默认放系统临时目录，而 PrivateTmp=true 会让 /tmp 变成
# 本 unit 的私有命名空间：同一 appID 的第二个 unit（或手工起的进程）看到的是
# 另一个 /tmp，两把锁互不可见，双开照样发生。改放 /run/qqbot（RuntimeDirectory
# 创建、同机所有 qqbot 实例共享）才能在单机范围内真正互斥。
RuntimeDirectory=qqbot
RuntimeDirectoryMode=0700
Environment=QQBOT_LOCK_DIR=/run/qqbot
# 认证已写入 /etc/qqbot/config.toml（600）。若改用环境变量覆盖，
# 再启用下面一行，AppID/Secret 不落配置文件。
# EnvironmentFile=-/etc/qqbot/env
Restart=on-failure
RestartSec=10
# 默认 KillMode=control-group 会把 SIGTERM 同时发给插件子进程，核心的
# 「RPC close → SIGTERM → Kill」三级关停根本没机会跑，于是每次 stop/restart
# 都刷出三条「插件进程异常退出」的假 ERROR 并白记一次失败计数。
# mixed 只给主进程发 SIGTERM，等它把插件收干净；超时才对整棵 cgroup 补 SIGKILL。
KillMode=mixed
TimeoutStopSec=30
MemoryMax=256M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# 一棵可写树覆盖全部运行期写入：SQLite 与 WAL、<datadir>/plugins/bin 的插件
# 产物、<datadir>/upgrade 的 state.json 与快照、以及自更新要替换的
# <datadir>/bin/qqbot（与其 .new/.old 同目录）。
ReadWritePaths=/var/lib/qqbot

[Install]
WantedBy=multi-user.target
